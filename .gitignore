#gitignore file

# tools working files
tools/*.nc
tools/INPUT
tools/output

# executables
*.exe

# runtime NetCDF output (keep canonical inputs in iofiles/)
run/*.nc

# iofiles: only the curated core input profiles are tracked (see
# iofiles/input_files/README). Local/development .nc files are ignored;
# already-tracked files override these patterns and stay versioned.
iofiles/input_files/*.nc
iofiles/output_files/*.nc

# python
__pycache__/

# editor/OS debris
*~
*.ps
*.eps
.DS_Store

# build artifacts
bld.*
*.mod

.claude

# refactoer branch
run/user_nl_exort

# regression harness: commit driver, fixtures, and golden baselines;
# ignore everything else under tests/ (including freshly produced run outputs)
tests/*
!tests/regression/
tests/regression/*
!tests/regression/run_regression.py
!tests/regression/README.md
!tests/regression/fixtures/
!tests/regression/baselines/
tests/regression/outputs/
